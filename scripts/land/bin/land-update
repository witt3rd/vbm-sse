#!/usr/bin/env bash
# land-update --check [--root DIR]
# land-update <tag|commit> [--root DIR]
#
# --check: READ-ONLY. Compares the pin (scripts/land/PIN) with the release tags of the source and prints one line:
#     vbm-land: pinned v0.1.0, latest v0.3.2: behind 4 releases (minor)        |      vbm-land: pinned v0.3.2 is the latest release: up to date
#   The class is the semver distance of the pin to the latest release: patch, minor or major. Exit 0 up to date | 1 behind (visible, never a gate: run it in a workflow of its own) |
#   2 not installed | 3 the source cannot be reached (not "up to date": nobody knows). Under GitHub Actions it also writes a warning annotation and a step-summary line when behind.
# land-update --diff <tag> [--root DIR]: verify the release (below) and show what it would change (changed, added and removed vendored files, their diffs, and the CHANGELOG entries newer than the pin); changes nothing.
# land-update --auto: the scheduled workflow's mode. Reads LAND_AUTO_UPDATE (none | patch | minor; default none) from the repository's land.conf on its base branch. none: reports like --check.
#   patch / minor: when a release within that class is out, does `--land` to the newest such release; a MAJOR release is never automatic (it is reported). On a red or a refusal it stops and exits non-zero.
# land-update --land <tag|commit>: the whole update as the repository's own act: verify, stage, commit `chore(land): vbm-land <version>` (with the trailers the repository's land.conf requires), then land it
#   through the repository's OWN lander and gates (its Tier 1, its hooks, its attack suite), run from a pristine fresh clone of the base branch, so the lander that lands the new copy is the old one already on
#   main. Needs a clean worktree. It stops on the first red or refusal and lands nothing (the commit stays local for you to look at); it never forces. Exit code: the lander's.
# <tag|commit>: VERIFY the release first (a signed tag from an allowed signer, recording the manifest it points at: scripts/land.signers makes this mandatory; without it the update says UNVERIFIED), then replace the vendored copy of this tool with the release named, from the source recorded in the PIN. It stages the new tree and PIN in the working tree and verifies
#   them; it commits nothing. Commit the result as ONE commit (`chore(land): vbm-land <version>`) and land it like any other change.
set -euo pipefail
export LC_ALL=C
here=$(cd "$(dirname "$0")" && pwd); . "$here/../lib/source.sh"
ref=; root=; check=0; diffonly=0; land=0; auto=0
usage() { echo "usage: land-update --check | land-update --diff <tag> | land-update [--land] <tag|commit>   [--root DIR]" >&2; exit 2; }
while [ $# -gt 0 ]; do case $1 in --root) root=${2:?--root needs a directory}; shift;; --check) check=1;; --diff) diffonly=1;; --land) land=1;; --auto) auto=1;; -*) usage;; *) ref=$1;; esac; shift; done
[ "$check" = 1 ] || [ "$auto" = 1 ] || [ -n "$ref" ] || usage
[ -n "$root" ] || root=$(git rev-parse --show-toplevel)
pin=$root/scripts/land/PIN
src=$(sed -n 's/^source=//p' "$pin" 2>/dev/null | sed -n 1p); [ -n "$src" ] || { echo "land-update: no scripts/land/PIN in $root: install first (install --source SRC <ref>)" >&2; exit 2; }
tmp=$(mktemp -d "${TMPDIR:-/tmp}/land-update.XXXXXX"); trap 'rm -rf "$tmp"' EXIT
if [ "$auto" = 1 ]; then   # the policy is the repository's own, read from its base branch (a change cannot grant itself an auto-update)
  . "$here/../lib/conf.sh"; conf_defaults
  git -C "$root" fetch -q origin 2>/dev/null || true
  b=$(git -C "$root" symbolic-ref -q --short refs/remotes/origin/HEAD | sed 's#^origin/##' || true); b=${b:-main}
  if git -C "$root" cat-file -e "origin/$b:scripts/land.conf" 2>/dev/null; then conf_parse land.conf < <(git -C "$root" show "origin/$b:scripts/land.conf") || exit 2; fi
  conf_validate >/dev/null 2>&1 || true
  if [ "$LAND_AUTO_UPDATE" = none ]; then echo "land-update --auto: LAND_AUTO_UPDATE=none: reporting only"; fi
fi
if [ "$check" = 1 ] || [ "$auto" = 1 ]; then
  pinned=$(sed -n 's/^version=//p' "$pin" | sed -n 1p); [[ "$pinned" =~ ^v[0-9]+\.[0-9]+\.[0-9]+ ]] || { echo "land-update: the PIN has no usable version= ($pinned)" >&2; exit 2; }
  src_fetch "$src" HEAD "$tmp/src" >/dev/null 2>"$tmp/err" || { echo "vbm-land: cannot reach the source $src to look for releases: $(cat "$tmp/err"): NOT verified up to date" >&2; exit 3; }
  tags=$(git -C "$tmp/src" tag --list 'v[0-9]*.[0-9]*.[0-9]*' | { grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' || true; } | LC_ALL=C sort -V)
  [ -n "$tags" ] || { echo "vbm-land: pinned $pinned; the source $src has no release tags yet: nothing to compare" ; exit 0; }
  latest=$(tail -n1 <<<"$tags"); base=${pinned%%-*}   # a pre-release label (v0.3.0-dev) is older than its own release
  behind=0; for t in $tags; do
    [ "$t" != "$pinned" ] || continue
    if [ "$t" = "$base" ] || [ "$(printf '%s\n%s\n' "$base" "$t" | LC_ALL=C sort -V | tail -n1)" = "$t" ]; then behind=$((behind + 1)); fi
  done
  [ "$behind" -gt 0 ] || { echo "vbm-land: pinned $pinned is the latest release ($latest): up to date"; exit 0; }
  IFS=. read -r pa pb pc <<<"${base#v}"; IFS=. read -r la lb lc <<<"${latest#v}"
  if [ "$la" != "$pa" ]; then class=major; elif [ "$lb" != "$pb" ]; then class=minor; else class=patch; fi
  line="vbm-land: pinned $pinned, latest $latest: behind $behind release$([ "$behind" = 1 ] || echo s) ($class)"
  echo "$line"
  if [ "${GITHUB_ACTIONS:-}" = true ]; then echo "::warning title=vbm-land update available::$line. Run the update-vbm-land skill (scripts/land/bin/land-update $latest)."; fi
  if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then echo "$line" >> "$GITHUB_STEP_SUMMARY"; fi
  [ "$auto" = 1 ] && [ "$LAND_AUTO_UPDATE" != none ] || exit 1
  # the newest release this repository allows itself to take: patch = same major.minor, minor = same major; a MAJOR release is never automatic
  target=; for t in $tags; do
    IFS=. read -r ta tb tc <<<"${t#v}"
    [ "$t" != "$pinned" ] || continue
    if [ "$t" != "$base" ] && [ "$(printf '%s\n%s\n' "$base" "$t" | LC_ALL=C sort -V | tail -n1)" != "$t" ]; then continue; fi
    case $LAND_AUTO_UPDATE in patch) [ "$ta.$tb" = "$pa.$pb" ] && target=$t;; minor) [ "$ta" = "$pa" ] && target=$t;; esac
  done
  [ -n "$target" ] || { echo "land-update --auto: no release within LAND_AUTO_UPDATE=$LAND_AUTO_UPDATE (a major waits for a person): reporting only"; exit 1; }
  echo "land-update --auto: updating to $target (LAND_AUTO_UPDATE=$LAND_AUTO_UPDATE), through this repository's own lander"
  ref=$target; land=1; rm -rf "$tmp/src"
fi
c=$(src_fetch "$src" "$ref" "$tmp/src") || exit 1
signers=; [ ! -r "$root/scripts/land.signers" ] || signers=$root/scripts/land.signers
vrc=0; src_verify "$tmp/src" "$ref" "$signers" || vrc=$?   # BEFORE anything of the new release runs: the installer below is the new release's own
[ "$vrc" != 1 ] || exit 1
if [ "$diffonly" = 1 ]; then
  mkdir -p "$tmp/tree"; git -C "$tmp/src" archive "$c" | tar -x -C "$tmp/tree"
  vpath() { case "$1" in skills/*) echo ".agents/$1";; *) echo "scripts/land/$1";; esac; }
  n=0; a=0; r=0; out=$tmp/diff.txt; : > "$out"
  while read -r _ f; do [ -n "$f" ] || continue; v=$(vpath "$f")
    if [ ! -e "$root/$v" ]; then a=$((a + 1)); echo "ADDED   $v" >> "$out"
    elif ! cmp -s "$tmp/tree/$f" "$root/$v"; then n=$((n + 1)); echo "CHANGED $v" >> "$out"; diff -u "$root/$v" "$tmp/tree/$f" | sed 's/^/    /' >> "$out" || true; fi
  done < "$tmp/tree/MANIFEST.sha256"
  while read -r _ f; do [ -n "$f" ] || continue; grep -q "  $f\$" "$tmp/tree/MANIFEST.sha256" || { r=$((r + 1)); echo "REMOVED $(vpath "$f")" >> "$out"; }; done < "$root/scripts/land/MANIFEST.sha256"
  echo "land-update --diff: $ref ($(cat "$tmp/tree/VERSION")) vs the pin: $n changed, $a added, $r removed"; cat "$out"
  pv=$(sed -n 's/^version=v//p' "$pin" | sed -n 1p)
  echo "--- CHANGELOG entries newer than $pv:"; awk -v pv="$pv" '/^## /{h=substr($0,4); if (h==pv) exit} {print}' "$tmp/tree/CHANGELOG.md" 2>/dev/null || true
  exit 0
fi
git -C "$tmp/src" show "$c:install" > "$tmp/install"
if [ "$land" = 1 ] && [ -n "$(git -C "$root" status --porcelain --untracked-files=no)" ]; then echo "land-update: --land needs a clean worktree (commit or stash your changes first)" >&2; exit 1; fi
bash "$tmp/install" --source "$src" --target "$root" "$ref"   # not exec: the trap must still remove $tmp
if [ "$land" = 1 ]; then
  . "$here/../lib/conf.sh"; conf_defaults
  git -C "$root" fetch -q origin || { echo "land-update: cannot fetch origin" >&2; exit 1; }
  base=$(git -C "$root" symbolic-ref -q --short refs/remotes/origin/HEAD | sed 's#^origin/##' || true); base=${base:-main}
  if git -C "$root" cat-file -e "origin/$base:scripts/land.conf" 2>/dev/null; then conf_parse land.conf < <(git -C "$root" show "origin/$base:scripts/land.conf") || exit 2; fi
  ver=$(sed -n 's/^version=//p' "$root/scripts/land/PIN" | sed -n 1p); msg=(-m "Vendored by land-update --land from $ref.")
  for t in $LAND_REQUIRE_TRAILERS; do msg+=(-m "$t: vbm-land-update-$ver"); done
  for p in scripts/land .agents/skills scripts/land.signers .github/workflows/vbm-land-update.yml scripts/land-direct scripts/land.conf; do [ ! -e "$root/$p" ] || git -C "$root" add -A -- "$p"; done
  git -C "$root" commit -q -m "chore(land): vbm-land $ver" "${msg[@]}" || { echo "land-update: nothing to commit: the pin already is $ver" >&2; exit 1; }
  git clone -q "$(git -C "$root" remote get-url origin)" "$tmp/old" || { echo "land-update: cannot make the pristine clone of $base" >&2; exit 1; }
  git -C "$tmp/old" checkout -q "origin/$base" 2>/dev/null || true
  echo "land-update: landing the update through this repository's own lander (a pristine clone of $base: the old lands the new)"
  rc=0; ( cd "$root" && "$tmp/old/scripts/land-direct" ) || rc=$?
  [ "$rc" = 0 ] || echo "land-update: NOT landed (the lander exited $rc): the commit is local; nothing reached $base. Look at the lander's message above." >&2
  exit "$rc"
fi
