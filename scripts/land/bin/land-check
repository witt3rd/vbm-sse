#!/usr/bin/env bash
# land-check [--upstream] [--root DIR]: is the vendored copy of this tool in DIR (default: the repository root) still exactly its pin?
#
# Offline (the default; in Tier 1; well under a second): scripts/land/PIN names the release (source, version, commit, manifest_sha256); the vendored
# MANIFEST.sha256 must hash to that value, every file it lists (under scripts/land/, and the skills in .agents/skills/) must hash to its entry and have its
# executable bit, and scripts/land/ may hold nothing else. ANY difference fails: edit the tool in its source repository, not the copy.
# The repository's own files (scripts/land.conf: known keys only; scripts/land.d/: hooks executable and correctly named, `*.sh` helpers allowed) are checked for being well formed, not for content.
#
# --upstream (the 6-hourly job; by hand): also fetch the manifest at the PINNED COMMIT from the source and require it to equal the local one, so a forged PIN
# and tree together fail; and say whether a newer release exists (advice, never a failure). Exit 3 when the source cannot be reached (not verified).
# Exit codes: 0 ok | 1 drift | 2 not installed or unreadable pin | 3 upstream not reachable.
set -euo pipefail
export LC_ALL=C
here=$(cd "$(dirname "$0")" && pwd); . "$here/../lib/source.sh"
upstream=0; root=
while [ $# -gt 0 ]; do case $1 in --upstream) upstream=1;; --root) root=${2:?--root needs a directory}; shift;; *) echo "usage: land-check [--upstream] [--root DIR]" >&2; exit 2;; esac; shift; done
[ -n "$root" ] || root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
pin=$root/scripts/land/PIN; man=$root/scripts/land/MANIFEST.sha256
[ -r "$pin" ] && [ -r "$man" ] || { echo "land-check: no pinned copy in $root (scripts/land/PIN or MANIFEST.sha256 missing): not installed" >&2; exit 2; }
pinval() { sed -n "s/^$1=//p" "$pin" | sed -n 1p; }
p_source=$(pinval source); p_version=$(pinval version); p_commit=$(pinval commit); p_msha=$(pinval manifest_sha256)
[ -n "$p_source" ] && [[ "$p_commit" =~ ^[0-9a-f]{40}$ ]] && [[ "$p_msha" =~ ^[0-9a-f]{64}$ ]] || { echo "land-check: scripts/land/PIN is unreadable (needs source=, version=, a 40-hex commit= and a manifest_sha256=)" >&2; exit 2; }
bad=0; drift() { echo "DRIFT: $*" >&2; bad=1; }
[ "$(sha256sum < "$man" | cut -d' ' -f1)" = "$p_msha" ] || drift "scripts/land/MANIFEST.sha256 does not hash to the pin's manifest_sha256"
vpath() { case "$1" in skills/*) echo ".agents/$1";; *) echo "scripts/land/$1";; esac; }   # where a payload path lives in a consumer
declare -A listed=()
while read -r h f; do
  [ -n "$f" ] || continue; v=$(vpath "$f"); listed[$v]=1
  if [ ! -f "$root/$v" ]; then drift "$v is missing"; continue; fi
  [ "$(sha256sum < "$root/$v" | cut -d' ' -f1)" = "$h" ] || drift "$v differs from the pinned release"
  case $f in bin/*) [ -x "$root/$v" ] || drift "$v is not executable";; esac
done < "$man"
while IFS= read -r f; do f=${f#"$root"/}; case $f in scripts/land/PIN|scripts/land/MANIFEST.sha256) continue;; esac
  [ -n "${listed[$f]:-}" ] || drift "$f is not part of the pinned release (an extra or local file inside the vendored tree)"
done < <(find "$root/scripts/land" -type f | LC_ALL=C sort)
# the repository's own files: well formed. scripts/land-direct is the repository's own entry script (install creates it from templates/land-direct-stub when absent; add what you need before the exec):
# it must be executable and still run the pinned lander.
entry=$(grep -v '^[[:space:]]*#' "$root/scripts/land-direct" 2>/dev/null || true)
{ [ -x "$root/scripts/land-direct" ] && grep -q 'land/bin/land-direct' <<<"$entry"; } || drift "scripts/land-direct is missing, not executable, or does not run the pinned lander (scripts/land/bin/land-direct)"
. "$here/../lib/conf.sh"; conf_defaults
if [ -r "$root/scripts/land.conf" ]; then conf_parse scripts/land.conf < "$root/scripts/land.conf" 2>&1 >/dev/null | sed 's/^/DRIFT: /' >&2 && [ "${PIPESTATUS[0]}" = 0 ] || bad=1; fi
if [ -d "$root/scripts/land.d" ]; then   # hooks have fixed names and must be executable; `*.sh` files are helpers the hooks source; anything else is a hook that would silently never run
  for h in "$root"/scripts/land.d/*; do [ -f "$h" ] || continue; n=${h##*/}
    case $n in
      prepare|pre-rebase|post-rebase|post-tier1|json-fields|on-run) [ -x "$h" ] || drift "scripts/land.d/$n is not executable (a hook that is not executable is silently never run)";;
      *.sh) ;;
      *) drift "scripts/land.d/$n is not a hook name (prepare, pre-rebase, post-rebase, post-tier1, json-fields, on-run) nor a *.sh helper: it would silently never run";;
    esac
  done
fi
if [ "$bad" != 0 ]; then echo "land-check: the vendored copy differs from its pin ($p_version, ${p_commit:0:12}). Edit vbm-land, not the copy; restore it with scripts/land/bin/land-update $p_version." >&2; exit 1; fi
msg="land-check: ok: vbm-land $p_version (${p_commit:0:12}) is intact"
if [ "$upstream" = 0 ]; then echo "$msg"; exit 0; fi
tmp=$(mktemp -d "${TMPDIR:-/tmp}/land-check.XXXXXX"); trap 'rm -rf "$tmp"' EXIT
src_fetch "$p_source" "$p_commit" "$tmp/src" >"$tmp/commit" 2>"$tmp/err" || { echo "land-check: cannot reach the source $p_source to verify the pin: $(cat "$tmp/err")" >&2; exit 3; }
[ "$(cat "$tmp/commit")" = "$p_commit" ] || { echo "DRIFT: the pinned commit $p_commit is not what the source resolves it to" >&2; exit 1; }
git -C "$tmp/src" show "$p_commit:MANIFEST.sha256" > "$tmp/manifest" 2>/dev/null || { echo "DRIFT: the source has no MANIFEST.sha256 at the pinned commit" >&2; exit 1; }
cmp -s "$tmp/manifest" "$man" || { echo "DRIFT: the manifest at the pinned commit $p_commit in $p_source differs from the vendored one (a forged pin and tree?)" >&2; exit 1; }
echo "$msg; the source confirms the manifest at the pinned commit"
latest=$(git -C "$tmp/src" tag --list 'v[0-9]*' 2>/dev/null | LC_ALL=C sort -V | tail -n1 || true)
if [ -n "$latest" ] && [ "$latest" != "$p_version" ] && [ "$(printf '%s\n%s\n' "$p_version" "$latest" | LC_ALL=C sort -V | tail -n1)" = "$latest" ]; then echo "land-check: advice: a newer release exists: $latest (pinned: $p_version). scripts/land/bin/land-update $latest"; fi
exit 0
