#!/usr/bin/env bash
# The ONE definition of a red main, read by bin/land-direct (and, later, the watchdog).
#
#   land-red        exit 0: main may be landed on | 10: main is RED | 14: landing is FROZEN | 20: not knowable (fail closed) | 2: bad usage
#
# RED = the Tier 1 job ($LAND_TIER1_JOB) of the latest PUSH run of $LAND_CI_WORKFLOW on $LAND_BASE failed (failure or timed_out), finished or not:
# Tier 1 success is green even while a later job of the same run is still going or failed. In mode push+dispatch the latest run of the workflow that was
# started by a dispatch counts too (a bot that merges with a token triggers no push run). Mode `off` has no CI to ask (a repository without CI yet).
#   * A Tier 1 that has not finished (or no Tier 1 job yet) is waited for $LAND_RED_WAIT seconds and then NOT counted: the lander's own Tier 1 is the gate.
#   * A failure whose annotations or failed log match the infrastructure classifier (lib/infra-re.sh) is not red.
#   * No run yet, or the workflow is not on the base branch yet (HTTP 404): nothing can be red.
#   * `gh` failing, or its answer unreadable: exit 20. Not knowing is not green.
# FROZEN = the freeze marker $LAND_STATE_DIR/freeze exists and has not expired (README, "Freeze"). It is a person's or the watchdog's act and is honoured in every mode.
# Environment: LAND_BASE LAND_CI_WORKFLOW LAND_TIER1_JOB LAND_RED_MODE LAND_RED_WAIT LAND_STATE_DIR (set by land-direct; defaults as in lib/conf.sh), GH, RED_SLEEP, RED_TIER1_POLL.
export LC_ALL=C
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
e_kf=${LAND_KNOWN_FLAKY_FILE-}; e_t2=${LAND_TIER2_JOB-}; e_rw=${LAND_FLAKY_RERUN_WAIT-}
e_base=${LAND_BASE-}; e_mode=${LAND_RED_MODE-}; e_wf=${LAND_CI_WORKFLOW-}; e_job=${LAND_TIER1_JOB-}; e_wait=${LAND_RED_WAIT-}   # what land-direct passed in
. "$here/../lib/conf.sh"; conf_defaults
base=${e_base:-$LAND_BASE}; mode=${e_mode:-$LAND_RED_MODE}; wf=${e_wf:-$LAND_CI_WORKFLOW}; t1job=${e_job:-$LAND_TIER1_JOB}; wait_s=${e_wait:-$LAND_RED_WAIT}
kf=$e_kf; t2job=${e_t2:-$LAND_TIER2_JOB}; rerun_wait=${e_rw:-$LAND_FLAKY_RERUN_WAIT}
gh=${GH:-gh}; poll_s=${RED_TIER1_POLL:-10}; sleeper=${RED_SLEEP:-sleep}
[ $# -eq 0 ] || { echo "usage: land-red" >&2; exit 2; }
case $mode in push|push+dispatch|off) ;; *) echo "land-red: unknown LAND_RED_MODE '$mode'" >&2; exit 2;; esac
state=${LAND_STATE_DIR:-$(git rev-parse --path-format=absolute --git-common-dir)/vbm-land}
. "$here/../lib/freeze.sh"
# TIER 2 (only when LAND_TIER2_JOB is set): the latest COMPLETED run's tier2 job decides the freeze that this tool itself sets: a real failure freezes landing (owner land-red, 24 h), a green run lifts it.
# An infrastructure failure does not freeze. A marker set by a person (--freeze) or by anything else is never touched here.
if [ -n "$t2job" ] && [ "$mode" != off ]; then
  . "$here/../lib/infra-re.sh"
  events2='.event=="push"'; [ "$mode" = push ] || events2='.event=="push" or .event=="workflow_dispatch"'
  r2=$("$gh" run list --workflow "$wf" --branch "$base" --status completed --limit 20 --json databaseId,event --jq "[.[]|select($events2)]|.[0].databaseId // empty" 2>/dev/null) || { echo "land-red: cannot tell whether $base is frozen (gh run list failed): not landing." >&2; exit 20; }
  if [ -n "$r2" ]; then
    j2=$("$gh" run view "$r2" --json jobs --jq '.jobs[]|[.name,(.conclusion // ""),(.databaseId|tostring)]|join("\u001f")') || { echo "land-red: cannot tell whether $base is frozen (gh run view failed): not landing." >&2; exit 20; }
    t2=; t2id=; while IFS=$'\x1f' read -r n c j; do if [ "$n" = "$t2job" ]; then t2=$c; t2id=${j:-}; fi; done <<<"$j2"
    mine=0; [ "$(freeze_field "$state/freeze" owner)" != land-red ] || mine=1
    case $t2 in
      success) if [ "$mine" = 1 ]; then rm -f "$state/freeze"; echo "land-red: $t2job of $base is green again: the freeze is lifted." >&2; fi;;
      failure|timed_out)
        if infra_failure "$r2" "$t2id"; then echo "land-red: $t2job of $base failed for an infrastructure reason: not freezing." >&2
        elif [ ! -e "$state/freeze" ]; then now=$(date +%s); mkdir -p "$state"; printf 'owner=land-red\nreason=%s failed on %s (run %s)\nsince=%s\nexpires=%s\n' "$t2job" "$base" "$r2" "$now" "$((now + 86400))" > "$state/freeze"; fi;;
    esac
  fi
fi
if freeze_active "$state/freeze"; then echo "land-red: $base is FROZEN: $(freeze_describe "$state/freeze"). Only a fix or a revert lands." >&2; exit 14; fi
[ "$mode" != off ] || exit 0
. "$here/../lib/infra-re.sh"
events='.event=="push"'; [ "$mode" = push ] || events='.event=="push" or .event=="workflow_dispatch"'
cannot() { echo "land-red: cannot tell whether $base is red ($1): not landing." >&2; exit 20; }
lid=; lsha=; lrt=; l1=; j1=
latest_tier1() {   # sets lid lsha lrt l1 j1 (l1 empty: no run / no Tier 1 job yet / not finished)
  local r jobs n c j err; lid=; lsha=; lrt=; l1=; j1=; err=$(mktemp)
  r=$("$gh" run list --workflow "$wf" --branch "$base" --limit 20 --json databaseId,headSha,displayTitle,event \
      --jq "[.[]|select($events)]|.[0]|select(.!=null)|[.databaseId,.headSha,.displayTitle]|join(\"\\u001f\")" 2>"$err") || {
    if grep -q 'HTTP 404.*workflow .* not found' "$err"; then rm -f "$err"; echo "land-red: workflow $wf is not on $base yet: nothing can be red." >&2; return 0; fi
    rm -f "$err"; cannot "gh run list failed"; }
  rm -f "$err"; [ -n "$r" ] || return 0
  IFS=$'\x1f' read -r lid lsha lrt <<<"$r"
  jobs=$("$gh" run view "$lid" --json jobs --jq '.jobs[]|[.name,(.conclusion // ""),(.databaseId|tostring)]|join("\u001f")') || cannot "gh run view $lid failed"
  while IFS=$'\x1f' read -r n c j; do if [ "$n" = "$t1job" ]; then l1=$c; j1=${j:-}; fi; done <<<"$jobs"
  return 0
}
waited=0; latest_tier1
while [ -z "$l1" ] && [ -n "$lid" ] && [ "$waited" -lt "$wait_s" ]; do
  step=$poll_s; [ $((waited + step)) -le "$wait_s" ] || step=$((wait_s - waited)); [ "$step" -gt 0 ] || break
  "$sleeper" "$step"; waited=$((waited + step)); latest_tier1
done
[ -z "$lid" ] || [ -n "$l1" ] || echo "land-red: the latest run of $base (${lsha:0:12}) has no finished $t1job job after ${waited}s: not a failure, proceeding." >&2
# KNOWN FLAKY: Tier 1 failed and EVERY test its failed log names (`FAIL <path>` or `FLAKY <path>`, compared by file name) is on the known-flaky list ($LAND_KNOWN_FLAKY_FILE: `name owner YYYY-MM-DD issue`,
# an entry that is malformed or expired is not listed): the failed job is rerun ONCE (`gh run rerun --failed`, only on attempt 1) and waited for up to $rerun_wait s; green = not red. Each rerun is a line in
# $state/known-flaky.log. Never for an unlisted failure, never a second time.
today=${RED_TODAY:-$(date -u +%F)}
kf_listed() {
  local n o d i; while read -r n o d i _; do case $n in ''|'#'*) continue;; esac
    [ "$n" = "$1" ] && [[ "$d" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && [ -n "$o" ] && [ -n "${i:-}" ] && ! [[ "$d" < "$today" ]] && return 0
  done < "$kf"; return 1
}
kf_rerun() {   # on success sets l1=success
  [ -n "$kf" ] && [ -r "$kf" ] || return 1
  local flog names t a0 a w=0 jobs n c res=timeout step
  flog=$("$gh" run view "$lid" --log-failed 2>/dev/null) || flog=
  names=$(grep -Eo '(FLAKY|FAIL) [A-Za-z0-9_./-]+' <<<"$flog" | awk '{n=split($2,p,"/"); print p[n]}' | LC_ALL=C sort -u || true)
  [ -n "$names" ] || return 1
  for t in $names; do kf_listed "$t" || { echo "land-red: $t1job failed on $t, which is not on the known-flaky list (or its entry is expired or malformed): no rerun." >&2; return 1; }; done
  a0=$("$gh" run view "$lid" --json attempt --jq .attempt 2>/dev/null) || a0=
  [ "$a0" = 1 ] || { echo "land-red: run $lid was already rerun (attempt ${a0:-?}): no second rerun." >&2; return 1; }
  echo "land-red: $t1job of ${lsha:0:12} failed only on known-flaky test(s) $(echo $names) (entries are debt: fix and remove): rerunning the failed job once, waiting up to ${rerun_wait}s." >&2
  if "$gh" run rerun "$lid" --failed >/dev/null 2>&1; then
    while :; do
      a=$("$gh" run view "$lid" --json attempt --jq .attempt 2>/dev/null) || a=
      if [[ "$a" =~ ^[0-9]+$ ]] && [ "$a" -gt "$a0" ]; then
        jobs=$("$gh" run view "$lid" --json jobs --jq '.jobs[]|[.name,(.conclusion // ""),(.databaseId|tostring)]|join("\u001f")' 2>/dev/null) || jobs=; c=
        while IFS=$'\x1f' read -r n c _; do [ "$n" = "$t1job" ] && break; c=; done <<<"$jobs"
        case $c in success) res=green; break;; failure|timed_out|cancelled|skipped) res=red; break;; esac
      fi
      [ "$w" -lt "$rerun_wait" ] || break
      step=$poll_s; [ $((w + step)) -le "$rerun_wait" ] || step=$((rerun_wait - w)); [ "$step" -gt 0 ] || break; "$sleeper" "$step"; w=$((w + step))
    done
  else res=refused; fi
  mkdir -p "$state"; printf '%s run %s %s known-flaky %s: rerun --failed: %s\n' "$(date -u +%FT%TZ)" "$lid" "${lsha:0:12}" "$(echo $names)" "$res" >> "$state/known-flaky.log"
  echo "land-red: the rerun of $lid (known flaky: $(echo $names)): $res" >&2
  [ "$res" = green ] || return 1
  l1=success; return 0
}
case $l1 in
  failure|timed_out)
    if infra_failure "$lid" "$j1"; then echo "land-red: $base is red for an infrastructure reason (${lsha:0:12}: $lrt; run $lid): not blocking." >&2; exit 0; fi
    if kf_rerun; then exit 0; fi
    echo "land-red: $base is red: the $t1job job of its latest run failed (${lsha:0:12}: $lrt)." >&2; exit 10;;
esac
exit 0
