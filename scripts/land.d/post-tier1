#!/usr/bin/env bash
# After Tier 1 passed: when the change touches a gate-defining file (gate-diff-improving.sh --touched), the RELABEL-ATTACK SUITE (main's copy) judges the PROPOSED gates:
# every demonstrated attack is applied to the proposed tree and its gates must refuse each one. Only such a change pays the minutes. A failing suite is exit 12.
set -euo pipefail
. "$(dirname "$0")/judge.sh"
j=$(judge_dir)
touched=$("$j/scripts/gate-diff-improving.sh" --touched "$LAND_BASE_REF" HEAD 2>/dev/null | paste -sd' ' || true)
[ -n "$touched" ] || exit 0
echo "land.d/post-tier1: gate-defining files touched ($touched): the relabel-attack suite judges the proposed gates"
start=$(date +%s); log="$LAND_STATE_DIR/attacks.log"
if ! mise exec -- "$j/scripts/relabel-attacks.sh" --tree . --base "$LAND_BASE_REF" >"$log" 2>&1; then
  { grep -E '^(PASSED|BROKEN|MISSING|FAIL)' "$log" || tail -5 "$log"; } >&2
  echo "land.d/post-tier1: the relabel-attack suite fails on the proposed gates (an attack passes them; log: $log); not landing." >&2; exit 12
fi
echo "land.d/post-tier1: relabel-attack suite: $(tail -1 "$log") [$(( $(date +%s) - start )) s wall, paid only because a gate-defining file is touched]"
