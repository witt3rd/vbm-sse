#!/usr/bin/env bash
# On the rebased, regenerated tree. (1) The protected set (scripts/protected-set.sh): touching it is allowed, every gate must pass; printed for the record.
# (2) The gate-diff judge (scripts/gate-diff-improving.sh --suite-judged, main's copy): a baseline may only improve, tier1.sh only gains plain steps, the protected list
# only grows; a list or gate-source change is judged by the relabel-attack suite (post-tier1). A refusal is exit 12: nothing lands.
set -euo pipefail
. "$(dirname "$0")/judge.sh"
j=$(judge_dir)
rc=0; prot=$("$j/scripts/protected-set.sh" "$LAND_BASE_REF" HEAD 2>/dev/null) || rc=$?
case $rc in 0) echo "land.d/post-rebase: protected set: none touched";; 1) echo "land.d/post-rebase: protected set: TOUCHED ($(echo $prot)): allowed, every gate must pass";; *) echo "land.d/post-rebase: protected set: could not be decided";; esac
rc=0; out=$("$j/scripts/gate-diff-improving.sh" --suite-judged "$LAND_BASE_REF" HEAD 2>&1) || rc=$?
if [ "$rc" != 0 ]; then printf '%s\n' "$out" | tail -8 >&2; echo "land.d/post-rebase: the gate-defining files of your commits are not purely improving (gate-diff-improving: exit $rc); not landing." >&2; exit 12; fi
